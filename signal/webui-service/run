#!/command/with-contenv sh

. /run/signal-addon/options.env

if [ "${WEBUI_ENABLED:-true}" != "true" ]; then
	# Keep the longrun service healthy while the UI is disabled.
	echo "Signal Web UI is disabled by WEBUI_ENABLED"
	exec s6-setuidgid signal-api sleep infinity
fi

exec s6-setuidgid signal-api python3 /opt/signal-webui/server.py
